{
  "_": "Shared by check_template (src-tauri/src/actions.rs) and templateProblem (src/actions/templateCheck.ts). bad: [template, text the error has].",
  "bad": [
    ["convert \"{path}\" out.png", "inside quotes"],
    ["echo '{name}'", "inside quotes"],
    ["echo \"a {paths} b\"", "inside quotes"],
    ["echo `basename {path}`", "backticks"],
    ["x \"$(echo `y {dir}`)\"", "backticks"],
    ["echo \"it's {stem}\"", "inside quotes"],
    ["cat <<EOF\n{name}\nEOF", "here-document"],
    ["cat <<-'X'\n{path}\nX", "here-document"],
    ["echo \\{path}", "backslash"],
    ["x $(cat <<E\n{dir}\nE\n)", "here-document"],
    ["cp {path} \"${DEST:-\"{dir}\"}\"", "inside quotes"],
    ["cp {path} ${DEST:-{dir}}", "${ … }"],
    ["echo ${x:-$(cat {path})}", "${ … }"],
    ["echo $'\\' {path} '", "inside quotes"],
    ["echo $'{name}'", "inside quotes"],
    ["echo $(( 1 + {name} ))", "arithmetic"],
    ["echo $(( {path} ))", "arithmetic"],
    ["(( n = {name} ))", "arithmetic"],
    ["echo $[ {name} + 1 ]", "arithmetic"],
    ["echo \"$(( {name} ))\"", "arithmetic"],
    ["# it's\necho '{path}'", "inside quotes"],
    ["echo hi # {path}", "comment"],
    ["echo a#'\necho '{path}'", "differently"],
    ["x \"$(case a in a) \" {path} \" ;; esac)\"", "differently"],
    ["echo $((1+2) ) {path}", "differently"]
  ],
  "ok": [
    "convert {path} out.png",
    "echo \"$(basename {path})\"",
    "awk '{print $1}' {path}",
    "echo \"${path}\" {name}",
    "echo \"a\" {path} 'b'",
    "echo \\\"{path}\\\"",
    "echo $( (cd {dir}) ) {path}",
    "echo \"{unknown}\" {ext}",
    "cat <<< {path}",
    "echo '<<' {path}",
    "echo \\\\ {path}",
    "cp {path} ${HOME}/Desktop/{name}",
    "cp {path} \"${DEST:-x}\" {dir}",
    "echo $((1 + 2)) {name}",
    "echo $'it\\'s' {name}",
    "echo $# {path}",
    "# copy it\ncp {path} /tmp",
    "echo \"$(cat {path} | wc -l)\"",
    "diff <(cat {path}) {dir}"
  ]
}
