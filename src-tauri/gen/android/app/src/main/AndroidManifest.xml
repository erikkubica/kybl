<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- uploads and downloads keep going in the background (TransferService.kt) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 7-10 only: saving downloads to the shared Download folder and photos to Pictures/Kybl
         (Android 10 included because of requestLegacyExternalStorage below; 11+ need no permission) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- the Wi-Fi only setting asks whether the connection is metered (src/platform/android.rs) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- app lock (PlatformPlugin.kt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- "Open with": to tell when no installed app can open a file (Android 11+ hides other apps otherwise) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- secret keys live in private storage (src/state.rs): keep them out of cloud backups -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.kybl"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- "Connect Kybl Storage": the account site sends the browser back to kybl://connect?code=…
                 (KyblConnectPlugin.kt) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kybl" android:host="connect" />
            </intent-filter>
            <!-- Cloud drive sign-in (src/oauth/mod.rs): Microsoft comes back to kybl://oauth/onedrive?code=…,
                 the loopback sign-ins (Google, Dropbox) end at kybl://oauth/done (KyblConnectPlugin.kt) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kybl" android:host="oauth" />
            </intent-filter>
            <!-- "Kybl" in other apps' share sheets: files to upload (ShareIntake.kt) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
          android:name=".TransferService"
          android:exported="false"
          android:foregroundServiceType="dataSync" />

        <!-- "Cancel" on the transfer notification -->
        <receiver
          android:name=".TransferCancelReceiver"
          android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
