<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The window and the Android 12+ launch splash use the page's own
         background, so launch never flashes white before the WebView paints. -->
    <style name="Theme.kybl" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/kybl_bg</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/kybl_bg</item>
    </style>
</resources>
